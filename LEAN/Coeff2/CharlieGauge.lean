import Coeff2.CharlieBipartite
import Mathlib.FieldTheory.Finiteness
import Mathlib.LinearAlgebra.Dimension.RankNullity

/-!
# Binary gauge states on the Charlieplex crown graph

A binary gauge assigns a bit to every vertex of the crown graph.  Its
coboundary adds the bits at the two endpoints of every Charlie channel.  The
global flip is invisible: adding one at every vertex changes each edge twice.

For radix `m ≥ 3`, the crown graph is connected.  We prove directly that the
global flip is the entire kernel.  Rank-nullity then gives

* `2^(2*m - 1)` distinct edge changes generated by vertex gauges;
* `2^(m*(m-1) - (2*m-1))` gauge-inequivalent binary edge states.

At radix eight the second exponent is `56 - 15 = 41`.
-/

namespace Coeff2

namespace Charlieplex

abbrev GaugeBit := ZMod 2

/-- One binary convention at every start/end phase vertex. -/
abbrev VertexGauge (m : ℕ) := CrownVertex m → GaugeBit

/-- One binary state on every Charlie channel. -/
abbrev EdgeState (m : ℕ) := DirectedChannel m → GaugeBit

/-- The endpoint coboundary: a vertex gauge changes an edge by the sum of its
two endpoint bits. -/
def gaugeBoundary (m : ℕ) : VertexGauge m →ₗ[GaugeBit] EdgeState m where
  toFun gauge channel :=
    gauge (.inl channel.1) + gauge (.inr channel.2.1)
  map_add' left right := by
    funext channel
    simp only [Pi.add_apply]
    abel
  map_smul' scalar gauge := by
    funext channel
    simp only [Pi.smul_apply, RingHom.id_apply]
    exact (mul_add scalar _ _).symm

@[simp]
theorem gaugeBoundary_apply {m : ℕ} (gauge : VertexGauge m)
    (channel : DirectedChannel m) :
    gaugeBoundary m gauge channel =
      gauge (.inl channel.1) + gauge (.inr channel.2.1) := rfl

/-- A zero boundary forces equality across every legal crown edge. -/
theorem gauge_eq_across_edge_of_boundary_zero {m : ℕ}
    (gauge : VertexGauge m) (hzero : gaugeBoundary m gauge = 0)
    (source sink : Fin m) (hne : sink ≠ source) :
    gauge (.inl source) = gauge (.inr sink) := by
  have hedge := congrFun hzero
    (⟨source, ⟨sink, hne⟩⟩ : DirectedChannel m)
  change gauge (.inl source) + gauge (.inr sink) = 0 at hedge
  rw [add_eq_zero_iff_eq_neg] at hedge
  simpa only [ZMod.neg_eq_self_mod_two] using hedge

/-- At least three phases provide a common end phase for any two starts. -/
theorem exists_common_sink {m : ℕ} (hm : 3 ≤ m) (a b : Fin m) :
    ∃ sink : Fin m, sink ≠ a ∧ sink ≠ b := by
  exact Fin.exists_ne_and_ne_of_two_lt a b (by omega)

/-- At least three phases provide a common start phase for any two ends. -/
theorem exists_common_source {m : ℕ} (hm : 3 ≤ m) (a b : Fin m) :
    ∃ source : Fin m, a ≠ source ∧ b ≠ source := by
  rcases Fin.exists_ne_and_ne_of_two_lt a b (by omega) with
    ⟨source, hsourcea, hsourceb⟩
  exact ⟨source, hsourcea.symm, hsourceb.symm⟩

/-- A zero-boundary gauge is constant on the left shore. -/
theorem gauge_left_constant_of_boundary_zero {m : ℕ} (hm : 3 ≤ m)
    (gauge : VertexGauge m) (hzero : gaugeBoundary m gauge = 0)
    (a b : Fin m) : gauge (.inl a) = gauge (.inl b) := by
  rcases exists_common_sink hm a b with ⟨sink, hsinka, hsinkb⟩
  exact (gauge_eq_across_edge_of_boundary_zero gauge hzero a sink hsinka).trans
    (gauge_eq_across_edge_of_boundary_zero gauge hzero b sink hsinkb).symm

/-- A zero-boundary gauge is constant on the right shore. -/
theorem gauge_right_constant_of_boundary_zero {m : ℕ} (hm : 3 ≤ m)
    (gauge : VertexGauge m) (hzero : gaugeBoundary m gauge = 0)
    (a b : Fin m) : gauge (.inr a) = gauge (.inr b) := by
  rcases exists_common_source hm a b with ⟨source, hasource, hbsource⟩
  exact (gauge_eq_across_edge_of_boundary_zero gauge hzero source a hasource).symm.trans
    (gauge_eq_across_edge_of_boundary_zero gauge hzero source b hbsource)

/-- Connectivity in the form needed by the gauge calculation: the kernel
consists exactly of the two constant gauges. -/
theorem gaugeBoundary_eq_zero_iff_constant {m : ℕ} (hm : 3 ≤ m)
    (gauge : VertexGauge m) :
    gaugeBoundary m gauge = 0 ↔
      ∃ bit : GaugeBit, ∀ vertex : CrownVertex m, gauge vertex = bit := by
  constructor
  · intro hzero
    let anchor : Fin m := ⟨0, by omega⟩
    refine ⟨gauge (.inl anchor), ?_⟩
    intro vertex
    cases vertex with
    | inl source =>
        exact gauge_left_constant_of_boundary_zero hm gauge hzero source anchor
    | inr sink =>
        rcases Fin.exists_ne_and_ne_of_two_lt sink sink (by omega) with
          ⟨source, hsourcesink, _⟩
        exact
          (gauge_eq_across_edge_of_boundary_zero gauge hzero source sink
            hsourcesink.symm).symm.trans
          (gauge_left_constant_of_boundary_zero hm gauge hzero source anchor)
  · rintro ⟨bit, hconstant⟩
    funext channel
    simp only [gaugeBoundary_apply]
    rw [hconstant, hconstant]
    exact ZModModule.add_self bit

/-- The constant-gauge map into the kernel. -/
noncomputable def constantGaugeKernelEquiv {m : ℕ} (hm : 3 ≤ m) :
    GaugeBit ≃ₗ[GaugeBit] LinearMap.ker (gaugeBoundary m) := by
  let toKernel : GaugeBit →ₗ[GaugeBit] LinearMap.ker (gaugeBoundary m) :=
    { toFun := fun bit =>
        ⟨fun _ => bit, by
          rw [LinearMap.mem_ker]
          exact (gaugeBoundary_eq_zero_iff_constant hm (fun _ => bit)).2
            ⟨bit, fun _ => rfl⟩⟩
      map_add' := by
        intro a b
        apply Subtype.ext
        funext vertex
        rfl
      map_smul' := by
        intro scalar bit
        apply Subtype.ext
        funext vertex
        rfl }
  exact LinearEquiv.ofBijective toKernel ⟨
    by
      intro a b hab
      have hfun := congrFun (congrArg Subtype.val hab) (.inl ⟨0, by omega⟩)
      exact hfun,
    by
      intro gauge
      rcases gaugeBoundary_eq_zero_iff_constant hm gauge.1 |>.1
          (LinearMap.mem_ker.mp gauge.2) with ⟨bit, hbit⟩
      refine ⟨bit, ?_⟩
      apply Subtype.ext
      funext vertex
      exact (hbit vertex).symm ⟩

/-- There is one redundant binary gauge dimension: the global flip. -/
theorem finrank_gaugeBoundary_ker {m : ℕ} (hm : 3 ≤ m) :
    Module.finrank GaugeBit (LinearMap.ker (gaugeBoundary m)) = 1 := by
  rw [← (constantGaugeKernelEquiv hm).finrank_eq]
  exact Module.finrank_self GaugeBit

/-- The raw vertex-gauge space has one bit at each of the `2*m` vertices. -/
theorem finrank_vertexGauge (m : ℕ) :
    Module.finrank GaugeBit (VertexGauge m) = 2 * m := by
  rw [Module.finrank_pi]
  simp only [CrownVertex, Fintype.card_sum, Fintype.card_fin]
  omega

/-- The binary state space has one bit at each of the `m*(m-1)` Charlie
channels. -/
theorem finrank_edgeState (m : ℕ) :
    Module.finrank GaugeBit (EdgeState m) = m * (m - 1) := by
  rw [Module.finrank_pi]
  exact card_directedChannel m

/-- Distinct vertex gauges induce `2*m-1` independent edge changes. -/
theorem finrank_gaugeBoundary_range {m : ℕ} (hm : 3 ≤ m) :
    Module.finrank GaugeBit (LinearMap.range (gaugeBoundary m)) = 2 * m - 1 := by
  have hrank := LinearMap.finrank_range_add_finrank_ker (gaugeBoundary m)
  rw [finrank_gaugeBoundary_ker hm, finrank_vertexGauge] at hrank
  omega

/-- There are `2^(2*m)` raw choices of vertex gauge. -/
theorem card_vertexGauges (m : ℕ) :
    Nat.card (VertexGauge m) = 2 ^ (2 * m) := by
  rw [Module.natCard_eq_pow_finrank (K := GaugeBit), Nat.card_zmod,
    finrank_vertexGauge]

/-- The kernel has cardinality two: identity and the global flip. -/
theorem card_gaugeBoundary_ker {m : ℕ} (hm : 3 ≤ m) :
    Nat.card (LinearMap.ker (gaugeBoundary m)) = 2 := by
  rw [Module.natCard_eq_pow_finrank (K := GaugeBit), Nat.card_zmod,
    finrank_gaugeBoundary_ker hm]
  norm_num

/-- Gauge-equivalence classes are the cokernel of the endpoint coboundary. -/
abbrev GaugeClasses (m : ℕ) :=
  EdgeState m ⧸ LinearMap.range (gaugeBoundary m)

/-- The cycle-space/gauge dimension of the radix-`m` crown graph. -/
theorem finrank_gaugeClasses {m : ℕ} (hm : 3 ≤ m) :
    Module.finrank GaugeBit (GaugeClasses m) =
      m * (m - 1) - (2 * m - 1) := by
  rw [Submodule.finrank_quotient, finrank_edgeState,
    finrank_gaugeBoundary_range hm]

/-- The gauge-invariant dimension is exactly Sylvester's Frobenius expression
for the consecutive coprime pair `m` and `m-1`. -/
theorem finrank_gaugeClasses_sylvester {m : ℕ} (hm : 3 ≤ m) :
    Module.finrank GaugeBit (GaugeClasses m) =
      m * (m - 1) - m - (m - 1) := by
  rw [finrank_gaugeClasses hm]
  omega

/-- Cardinality of the effective gauge transformations. -/
theorem card_effectiveGaugeChanges {m : ℕ} (hm : 3 ≤ m) :
    Nat.card (LinearMap.range (gaugeBoundary m)) = 2 ^ (2 * m - 1) := by
  rw [Module.natCard_eq_pow_finrank (K := GaugeBit), Nat.card_zmod,
    finrank_gaugeBoundary_range hm]

/-- Cardinality of gauge-inequivalent binary edge states. -/
theorem card_gaugeClasses {m : ℕ} (hm : 3 ≤ m) :
    Nat.card (GaugeClasses m) =
      2 ^ (m * (m - 1) - (2 * m - 1)) := by
  rw [Module.natCard_eq_pow_finrank (K := GaugeBit), Nat.card_zmod,
    finrank_gaugeClasses hm]

/-- The radix-eight crown graph has `2^15` effective gauge changes and
`2^41` gauge-inequivalent binary edge states. -/
theorem gauge_eight_cardinality :
    Nat.card (LinearMap.range (gaugeBoundary 8)) = 2 ^ 15 ∧
    Nat.card (GaugeClasses 8) = 2 ^ 41 := by
  constructor
  · simpa using card_effectiveGaugeChanges (m := 8) (by omega)
  · simpa using card_gaugeClasses (m := 8) (by omega)

end Charlieplex

end Coeff2
