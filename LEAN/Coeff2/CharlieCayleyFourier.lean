import Mathlib.GroupTheory.Perm.Sign
import Mathlib.Tactic

/-!
# Cayley eigenmodes of the moving Charlie frame

The Boolean cache is diagonalized by Walsh characters, but the address frame
itself moves in a permutation group.  Its natural transition operator is
Cayley convolution.  This file records the general, finite-generator theorem:
every multiplicative character is an exact eigenfunction of that operator.

For a symmetric group, permutation sign supplies the parity character.  The
result does not depend on `n = 8`, on a corpus, or on a search heuristic.
-/

namespace Coeff2

namespace Charlieplex

section Cayley

variable {Group Scalar : Type*} [Monoid Group] [CommSemiring Scalar]

/-- One unnormalised step of the left Cayley walk generated by `generators`. -/
def cayleyStep (generators : Finset Group) (value : Group → Scalar) :
    Group → Scalar :=
  fun state => ∑ generator ∈ generators, value (generator * state)

/-- The Fourier coefficient attached to a one-dimensional character. -/
def characterEigenvalue (generators : Finset Group)
    (character : Group →* Scalar) : Scalar :=
  ∑ generator ∈ generators, character generator

/-- Every multiplicative character is an exact eigenfunction of Cayley
convolution.  This is the representation-free core of the parity law. -/
theorem cayleyStep_character (generators : Finset Group)
    (character : Group →* Scalar) (state : Group) :
    cayleyStep generators character state =
      characterEigenvalue generators character * character state := by
  simp [cayleyStep, characterEigenvalue, map_mul, Finset.sum_mul]

/-- Scalar multiplication commutes with an unnormalised Cayley step. -/
theorem cayleyStep_smul (generators : Finset Group) (constant : Scalar)
    (value : Group → Scalar) :
    cayleyStep generators (fun state => constant * value state) =
      fun state => constant * cayleyStep generators value state := by
  funext state
  simp [cayleyStep, Finset.mul_sum]

/-- Repeating the walk raises a character's eigenvalue to the number of
steps. -/
theorem cayleyStep_iterate_character (generators : Finset Group)
    (character : Group →* Scalar) (steps : ℕ) :
    (cayleyStep generators)^[steps] (fun state => character state) =
      fun state => (characterEigenvalue generators character) ^ steps *
        character state := by
  induction steps with
  | zero =>
      funext state
      simp
  | succ steps ih =>
      rw [Function.iterate_succ_apply', ih, cayleyStep_smul]
      funext state
      rw [cayleyStep_character]
      simp [pow_succ, mul_assoc]

end Cayley

section PermutationSign

variable {Address : Type*} [Fintype Address] [DecidableEq Address]

/-- Permutation sign, coerced from the units of `ℤ` to an integer-valued
multiplicative character. -/
noncomputable def permutationSignCharacter : Equiv.Perm Address →* ℤ :=
  (Units.coeHom ℤ).comp Equiv.Perm.sign

@[simp]
theorem permutationSignCharacter_apply (permutation : Equiv.Perm Address) :
    permutationSignCharacter permutation =
      (Equiv.Perm.sign permutation : ℤˣ) :=
  rfl

/-- Parity is therefore an exact eigenmode of every finite symmetric-group
Cayley walk, independent of how the generator family was obtained. -/
theorem cayleyStep_permutationSign (generators : Finset (Equiv.Perm Address))
    (state : Equiv.Perm Address) :
    cayleyStep generators permutationSignCharacter state =
      characterEigenvalue generators permutationSignCharacter *
        permutationSignCharacter state :=
  cayleyStep_character generators permutationSignCharacter state

end PermutationSign

section FragmentationParity

/-- The alternating sign contribution from depths `1, ..., p` when the
ambient permutation size is odd.  The index `k` represents depth `k + 1`. -/
def oddFragmentationEigenvalue (p : ℕ) : ℤ :=
  ∑ k ∈ Finset.range p, (-1 : ℤ) ^ k

/-- Successive odd-size fragmentation depths add alternating signs. -/
theorem oddFragmentationEigenvalue_succ (p : ℕ) :
    oddFragmentationEigenvalue (p + 1) =
      oddFragmentationEigenvalue p + (-1 : ℤ) ^ p := by
  simp [oddFragmentationEigenvalue, Finset.sum_range_succ]

/-- The alternating depth sum is zero after an even number of depths and one
after an odd number. -/
theorem oddFragmentationEigenvalue_closed (p : ℕ) :
    oddFragmentationEigenvalue p = if p % 2 = 0 then 0 else 1 := by
  induction p using Nat.twoStepInduction with
  | zero => simp [oddFragmentationEigenvalue]
  | one => simp [oddFragmentationEigenvalue]
  | more p ih0 ih1 =>
      rw [oddFragmentationEigenvalue_succ, oddFragmentationEigenvalue_succ,
        ih0]
      have hpow : (-1 : ℤ) ^ p + (-1 : ℤ) ^ (p + 1) = 0 := by
        ring
      have hmod : (p + 2) % 2 = p % 2 := by omega
      rw [hmod, add_assoc, hpow, add_zero]

/-- Closed parity eigenvalue of the fragmentation generator family.  The
combinatorial input is that the signed indecomposable contribution at depth
`d` is `(-1)^(d-1)`; moving that block across `n-d` addresses contributes
`(-1)^(d*(n-d))`.  Their product is constantly `-1` for even `n` and
alternates from `+1` for odd `n`. -/
def fragmentationSignEigenvalue (n p : ℕ) : ℤ :=
  if n % 2 = 0 then -(p : ℤ) else oddFragmentationEigenvalue p

theorem fragmentationSignEigenvalue_closed (n p : ℕ) :
    fragmentationSignEigenvalue n p =
      if n % 2 = 0 then -(p : ℤ)
      else if p % 2 = 0 then 0 else 1 := by
  simp [fragmentationSignEigenvalue, oddFragmentationEigenvalue_closed]

theorem fragmentationSignEigenvalue_even_size {n p : ℕ}
    (hn : n % 2 = 0) :
    fragmentationSignEigenvalue n p = -(p : ℤ) := by
  simp [fragmentationSignEigenvalue, hn]

theorem fragmentationSignEigenvalue_odd_size_even_depth {n p : ℕ}
    (hn : n % 2 = 1) (hp : p % 2 = 0) :
    fragmentationSignEigenvalue n p = 0 := by
  rw [fragmentationSignEigenvalue_closed]
  simp [hn, hp]

theorem fragmentationSignEigenvalue_odd_size_odd_depth {n p : ℕ}
    (hn : n % 2 = 1) (hp : p % 2 = 1) :
    fragmentationSignEigenvalue n p = 1 := by
  rw [fragmentationSignEigenvalue_closed]
  simp [hn, hp]

/-- The observed `n = 8`, depth-six imbalance is the general even-size law. -/
example : fragmentationSignEigenvalue 8 6 = -6 := by decide

/-! ## Two-step inverse returns

For prefix-reappend depths `d` and `e`, solving the inverse equations leaves
no solution when `d + e ≤ n`.  When `d + e = n + k`, the forced coordinates
leave exactly a permutation of `k` crossing coordinates, hence `k!`
solutions.  Summing over all depth pairs bounded by `p` gives the following
one-variable formula with excess `t = 2p - n`.

The definition below is the arithmetic side of that bijection.  The explicit
move-level bijection is deliberately kept separate from this theorem so that
enumerative evidence cannot silently become a formal assumption.
-/

/-- Arithmetic inverse-return count at half-depth excess `t`. -/
def inverseReturnCountFromExcess (t : ℕ) : ℕ :=
  ∑ j ∈ Finset.range t, (t - j) * (j + 1).factorial

/-- The bounded two-step return formula depends on `n,p` only through
`2p-n`. -/
def boundedInversePairCountFormula (n p : ℕ) : ℕ :=
  inverseReturnCountFromExcess (2 * p - n)

/-- Before the profile crosses half depth, a bounded move cannot have a
bounded inverse. -/
theorem boundedInversePairCountFormula_eq_zero_of_below_half {n p : ℕ}
    (hbelow : 2 * p ≤ n) :
    boundedInversePairCountFormula n p = 0 := by
  simp [boundedInversePairCountFormula, inverseReturnCountFromExcess,
    Nat.sub_eq_zero_of_le hbelow]

/-- Every positive half-depth excess creates at least one inverse return. -/
theorem inverseReturnCountFromExcess_succ_pos (t : ℕ) :
    0 < inverseReturnCountFromExcess (t + 1) := by
  apply Finset.sum_pos'
  · intro j hj
    exact Nat.zero_le _
  · refine ⟨0, by simp, ?_⟩
    simp

/-- At `n=8,p=6`, the general excess formula is exactly the observed 46
ordered inverse pairs. -/
theorem boundedInversePairCountFormula_eight_six :
    boundedInversePairCountFormula 8 6 = 46 := by
  norm_num [boundedInversePairCountFormula, inverseReturnCountFromExcess,
    Finset.sum_range_succ]

/-- One further fragmentation layer raises the inverse-pair count from 46 to
1072. -/
theorem boundedInversePairCountFormula_eight_seven :
    boundedInversePairCountFormula 8 7 = 1072 := by
  norm_num [boundedInversePairCountFormula, inverseReturnCountFromExcess,
    Finset.sum_range_succ]

end FragmentationParity

end Charlieplex

end Coeff2
